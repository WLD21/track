/*


Full source (including license, if applicable) included below.
*/
P.when('A')
    .register('sbv-automated-test-metrics-client', function (A) {

    function AutomatedTestMetricsClient(videoSingleProduct) {
        // Make the attribute unique enough to avoid collision.
        var AUTOMATED_TEST_METRICS_ATTR = "AUTOMATED_TEST_METRICS_ATTR";

        this.videoSingleProduct = videoSingleProduct;

        this.processEvent = function(metric) {
            var metrics = this.videoSingleProduct.data(AUTOMATED_TEST_METRICS_ATTR);
            if (metrics === undefined) {
                metrics = [];
            }
            metrics.push(metric);
            this.videoSingleProduct.data(AUTOMATED_TEST_METRICS_ATTR, metrics);
        }
    }

    return {
        newClient: function (videoSingleProduct) {
            return new AutomatedTestMetricsClient(videoSingleProduct);
        }
    };
});


