            A.on(A.constants.BROWSER_EVENTS.SCROLL, throttledOnBrowserViewChange);
            A.on(A.constants.BROWSER_EVENTS.RESIZE, throttledOnBrowserViewChange);
            A.on(A.constants.BROWSER_EVENTS.ORIENTATION_CHANGE, throttledOnBrowserViewChange);

