/*


Full source (including license, if applicable) included below.
*/
'use strict';

P.when('A', 'rush-framework', 'sbv-video-single-mixin', 'sbv-single-product', 'sbv-brand-info')
    .register('sbv-video-multi-product', function VideoMultiProduct(A, RushFramework, SBVVideoSingleMixin, SingleProduct, BrandInfo) {
        var VideoMultiProduct = function() {
            this.name = 'sbv-video-multi-product';
            this.attribution = 'sbv-video-multi-product';
        };

        A.mixin(VideoMultiProduct.prototype, SBVVideoSingleMixin);

        var videoMultiProductComponent = new VideoMultiProduct();

        function VideoMultiProductComponentSetup (component) {
            var $videoMultiProduct = A.$(component.elem());

            // Find product container with all ASIN cards
            var sbvProductElems = $videoMultiProduct.find('.sbv-product-container');

            var sbvBrandInfoElem = $videoMultiProduct.get(0);

            videoMultiProductComponent.setup(videoMultiProductComponent.attribution, $videoMultiProduct, sbvProductElems, sbvBrandInfoElem, component, SingleProduct, BrandInfo);
        }

        RushFramework.registerComponent(videoMultiProductComponent.name, videoMultiProductComponent.attribution, VideoMultiProductComponentSetup);
    });


