/**
 * POST requests clients. Contains generic logic for sending given data to given endpoint with a POST request.
 * Two clients:
 *   - ue._sBcn - uses sendBeacon to send the data
 *   - ue._ajx - uses Ajax object to send the data
 *
 */
P.register('sbv-transportation-client', function () {
    var dummyException = '';
    var dummyFunction = function () {
    };

    /**
     * Client for generating generic POST request with Ajax.
     *
     * @type {{send, isSupported}}
     */
    var ajaxClient = (function () {
        function buildXDomainRequest() {
            var request = new window.XDomainRequest();

            // older browsers gracefully accept undefined handlers for the XDomainRequest method, but IE9
            // aborts requests sometimes which is why these empty handlers are added here
            // http://social.msdn.microsoft.com/Forums/ie/en-US/30ef3add-767c-4436-b8a9-f1ca19b4812e/ie9-rtm-xdomainrequest-issued-requests-may-abort-if-all-event-handlers-not-specified
            // http://cypressnorth.com/programming/internet-explorer-aborting-ajax-requests-fixed/
            request.onerror = dummyFunction;
            request.ontimeout = dummyFunction;
            request.onprogress = dummyFunction;
            request.onload = dummyFunction;
            request.timeout = 0;

            return request;
        }

        function buildXMLHttpRequest() {
            var request = new window.XMLHttpRequest();
            if (!('withCredentials' in request)) {
                throw dummyException;
            }
            return request;
        }

        function buildAjaxObject() {
            // XDomainRequest was added for IE8 and IE9. IE10 supports cross-domain AJAX with
            // XMLHttpRequest directly
            // http://blogs.msdn.com/b/ieinternals/archive/2010/05/13/xdomainrequest-restrictions-limitations-and-workarounds.aspx
            if (window.XDomainRequest) {
                return buildXDomainRequest();
            } else if (window.XMLHttpRequest) { /* For normal browsers */
                return buildXMLHttpRequest();
            }
            return null;
        }

        function send(endpoint, payload) {
            if (payload && endpoint) {
                var ajaxObject = buildAjaxObject();
                if (!ajaxObject) {
                    throw dummyException;
                }
                ajaxObject.open('POST', endpoint, true);
                if (ajaxObject.setRequestHeader) {
                    ajaxObject.setRequestHeader('Content-type', 'text/plain');
                }
                ajaxObject.send(payload);
            }
        }

        return {
            send: send,
            isSupported: true
        };
    }());

    /**
     * Client for generating generic POST requests with sendBeacon.
     *
     * @type {{send, isSupported}}
     */
    var beaconClient = (function () {
        function send(endpoint, payload) {
            if (endpoint && payload) {
                /* If the data failed to be queued by the User Agent, then use the next client in line. */
                if (!window.navigator.sendBeacon(endpoint, payload)) {
                    throw dummyException;
                }
            }
        }

        function isSupported() {
            return !!window.navigator.sendBeacon;
        }

        return {
            send: send,
            isSupported: isSupported()
