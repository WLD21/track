/////////////////////////
// BEGIN FILE js/modules/slideshow/MultiBrandVideoCarousel.js
/////////////////////////
/*


Full source (including license, if applicable) included below.
*/
P.when('A', 'sbv-multi-brand-video-carousel-mixin')
    .register('sbv-multi-brand-video-carousel', function MultiBrandVideoCarousel(A, MultiBrandVideoCarouselMixin) {
        var MultiBrandVideoCarousel = function() {
            this.mbvCarouselItemElements = undefined;
            this.currentPlayingIndex = undefined;
        };

        A.mixin(MultiBrandVideoCarousel.prototype, MultiBrandVideoCarouselMixin);

        return {
            initialize: function($mbvCarouselContainer, metricsManager, attribution, instrumentationPixelUrl) {
                var multiBrandVideoCarousel = new MultiBrandVideoCarousel();
                multiBrandVideoCarousel.init($mbvCarouselContainer, metricsManager, attribution, instrumentationPixelUrl);
                return multiBrandVideoCarousel;
            }
        }
    });


/////////////////////////
// END FILE js/modules/slideshow/MultiBrandVideoCarousel.js
/////////////////////////
/////////////////////////
// BEGIN FILE js/modules/slideshow/MultiBrandVideoCarouselMixin.js
/////////////////////////
/*


Full source (including license, if applicable) included below.
*/
P.when('A', 'a-carousel-framework', 'sbv-video', 'sbv-single-product', 'sbv-viewability-manager', 'sbv-metrics-manager')
    .register('sbv-multi-brand-video-carousel-mixin', function (A, CarouselFramework, Video, SingleProduct, ViewabilityManager, MetricsManager) {
        var mbvCarousel = this;

        var onCarouselPageChange = function(eventData) {
            var newPage = eventData.newValue - 1;

            //Pause current video
            var currVideo = mbvCarousel.mbvCarouselItemElements[mbvCarousel.currentPlayingIndex].video;
            currVideo.onFiftyPercentViewability(0, false);
            currVideo.onOnePercentViewability(0, false);

            //Start playing new video
            var newVideo = mbvCarousel.mbvCarouselItemElements[newPage].video;
            newVideo.onOnePercentViewability(1, true);
            newVideo.onFiftyPercentViewability(1, true);

            mbvCarousel.currentPlayingIndex = newPage;
        }

        var initializeCarouselElements = function($mbvCarouselItems, metricsManager, attribution, instrumentationPixelUrl) {
            $mbvCarouselItems.get().reduce(function(mbvCarouselItemElements, mbvCarouselItemElement) {
                var mbvVideoElem = mbvCarouselItemElement.getElementsByClassName("sbv-video")[0];
                var video = Video.initialize(attribution, mbvVideoElem, metricsManager, instrumentationPixelUrl);

                var mbvProductElem = mbvCarouselItemElement.getElementsByClassName("sbv-product")[0];
                var singleProduct = SingleProduct.initialize(mbvProductElem, metricsManager, video);

                mbvCarouselItemElements[mbvCarouselItemElement.dataset.mbvIndex] = {
                    video: video,
                    product: singleProduct
                };

                return mbvCarouselItemElements;
            }, mbvCarousel.mbvCarouselItemElements);
        }

        var getMbvCarouselItemElements = function() {
            return mbvCarousel.mbvCarouselItemElements;
        }

        return {
            init: function($mbvCarouselContainer, metricsManager, attribution, instrumentationPixelUrl) {
                mbvCarousel.mbvCarouselItemElements = {};
                mbvCarousel.currentPlayingIndex = 0;
                var $mbvCarouselItems = $mbvCarouselContainer.find('.sbv-mbv-carousel-element');

                CarouselFramework.onInit('mbv-carousel', function(carousel) {
                    initializeCarouselElements($mbvCarouselItems, metricsManager, attribution, instrumentationPixelUrl);
                    A.on("a:carousel:mbv-carousel:change:pageNumber", onCarouselPageChange);
                });
                return this;
            },
            onCarouselPageChange: onCarouselPageChange,
            initializeCarouselElements: initializeCarouselElements,
            getMbvCarouselItemElements: getMbvCarouselItemElements
        }
    });


/////////////////////////
// END FILE js/modules/slideshow/MultiBrandVideoCarouselMixin.js
/////////////////////////
/////////////////////////
// BEGIN FILE js/modules/state/PageState.js
/////////////////////////
/*


Full source (including license, if applicable) included below.
*/
P.when('A')
.register('sbv-page-state', function(A) {
    function addItem(key, value) {
        var sbVideoState = getState();
        sbVideoState[key] = value;

        updatePageState(sbVideoState);
    }

    function getItem(key) {
        return getState()[key];
    }

    function getState() {
        return A.state('sb-video-state') || {};
    }

    function removeItem(key) {
        var sbVideoState = getState();
        delete sbVideoState[key];
        updatePageState(sbVideoState);
    }

    function updatePageState(sbVideoState) {
        A.state('sb-video-state', sbVideoState);
    }

    return {
        addItem: addItem,
        getItem: getItem,
        getState: getState,
        removeItem: removeItem,
        updateItem: addItem
    };
});


/////////////////////////
// END FILE js/modules/state/PageState.js
/////////////////////////
/////////////////////////
// BEGIN FILE js/modules/utils/index.js
/////////////////////////
/*


Full source (including license, if applicable) included below.
*/
P.register('sbv-client-util', function() {
    function isProgressiveScroll () {
        var position = null;
        P.now('s-progressive-scroll-position')
            .execute(function getProgressiveStart (progressiveScrollPosition) {
                    if (progressiveScrollPosition) {
                        position = progressiveScrollPosition.get();
                    }
                }
            );
        return Boolean(position);
    }

    function getWidgetDimensions(widgetElement) {
        var adDimension = {};
        if(widgetElement && widgetElement[0] && widgetElement[0].getBoundingClientRect) {
            adDimension = widgetElement[0].getBoundingClientRect();
        }

        return {
            width: adDimension.width || 0,
            height: adDimension.height || 0,
            viewportWidth: window.innerWidth,
            viewportHeight: window.innerHeight
        };
    }

    var EXECUTION_MODES = {
        AF_PAGE_2_PLUS_MOBILE: 'AF_PAGE_2_PLUS_MOBILE',
        AF: 'AF',
    }

    return {
        isProgressiveScroll: isProgressiveScroll,
        EXECUTION_MODES: EXECUTION_MODES,
        getWidgetDimensions: getWidgetDimensions
    }
});


