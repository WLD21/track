P.when('A', 'sbv-video-mixin').register('sbv-video', function Video(A, SBVVideoMixin) {
    // this can be thought of as the constructor
    var Video = function () {
        this.videoPlayer = null;
        this.$muteIcon = null;
        this.$unmuteIcon = null;
        this.$muteClickRegion = null;
        this.$pauseClickRegion = null;
        this.$playIcon = null;
        this.metricsManager = null;
        this.onScreenStartTime = 0;
        this.videoTag = null;
        this.isVcpmEnabled = false;
        this.adUnit = null;
    };

    A.mixin(Video.prototype, SBVVideoMixin);

    return {
        initialize: function (
            attribution,
            sbvVideoElem,
            metricsManager,
            instrumentationPixelUrl,
            isVcpmEnabled,
            adUnit
        ) {
            var video = new Video();
            video.init(attribution, sbvVideoElem, metricsManager, instrumentationPixelUrl, isVcpmEnabled, adUnit);
            return video;
        },
    };
});


