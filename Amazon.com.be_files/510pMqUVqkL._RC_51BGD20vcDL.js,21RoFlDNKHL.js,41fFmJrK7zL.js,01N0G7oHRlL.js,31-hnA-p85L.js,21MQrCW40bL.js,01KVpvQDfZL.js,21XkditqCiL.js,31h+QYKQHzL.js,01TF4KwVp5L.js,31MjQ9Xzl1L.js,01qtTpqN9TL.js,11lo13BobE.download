/*


Full source (including license, if applicable) included below.
*/
'use strict';

P.when('A', 'rush-framework', 'sbv-video-single-mixin', 'sbv-single-product', 'sbv-store-ingress')
    .register('sbv-video-single-product', function VideoSingleProduct(A, RushFramework, SBVVideoSingleMixin, SingleProduct, StoreIngress) {
        var VideoSingleProduct = function() {
            this.name = 'sbv-video-single-product';
            this.attribution = 'sbv-video-single-product';
        };

        A.mixin(VideoSingleProduct.prototype, SBVVideoSingleMixin);

        var videoSingleProductComponent = new VideoSingleProduct();

        function VideoSingleProductComponentSetup (component) {
            var $videoSingleProduct = A.$(component.elem());
            var sbvProductElem = $videoSingleProduct.find('.sbv-product:first').get(0);
            var sbvStoreIngressElem = $videoSingleProduct.find('.sbv-store-ingress:first').get(0);
            videoSingleProductComponent.setup(videoSingleProductComponent.attribution, $videoSingleProduct, sbvProductElem, sbvStoreIngressElem, component, SingleProduct, StoreIngress);
        }

        RushFramework.registerComponent(videoSingleProductComponent.name, videoSingleProductComponent.attribution, VideoSingleProductComponentSetup);
    });


