/////////////////////////
/*


Full source (including license, if applicable) included below.
*/
P.when(
    'A',
    'sbv-viewability-manager',
    'sbv-metrics-manager',
    'sbv-video-player-builder',
    'sbv-platform-compatibility',
    '3p-promise',
    'sbv-adblock-detector'
).register(
    'sbv-video-mixin',
    function (
        A,
        ViewabilityManager,
        MetricsManager,
        VideoPlayerBuilder,
        PlatformCompatibility,
        Promise,
        SBVAdBlockDetector
    ) {
        var STYLE_AUI_HIDE = 'aok-hidden';
        var STYLE_AUI_SHOW = 'aok-block';
        var STYLE_MUTE = 'sbv-video-mute-icon';
        var STYLE_UNMUTE = 'sbv-video-unmute-icon';
        var DURATION_PLAYED_MRC_MS = 2000;
        var DURATION_PLAYED_GROUPM_MS = 15000;
        var CONTINUOUS_DURATION_PLAYED_MRC_MS = 2000;
        var TAPPING_TIMES_NEED_TO_SHOW_DEBUG_INFO = 5;
        var TIME_DEBUG_COPIED_MESSAGE_SHOW = 3000;
        var times_of_click_mute_button = 0;

        // First-frame preview profiles. When a first-frame poster fails to load, fall back to the
        // 3-second frame by reversing the token in the URL.
        var THUMBNAIL_360P_FRAME_0_CAPTURE_1 = 'THUMBNAIL_360P_FRAME_0_CAPTURE_1';
        var THUMBNAIL_360P_FRAME_3_CAPTURE_2 = 'THUMBNAIL_360P_FRAME_3_CAPTURE_2';

        var viewMetricsHistoryMap = {
            isViewedLogged: false,
            isAdUnitViewLogged: false,
            isProgressFiveSecondsLogged: false,
            isFirstQuartileLogged: false,
            isMidpointLogged: false,
            isThirdQuartileLogged: false,
            isCompleteLogged: false,
            isUnmuteLogged: false,
        };

        return {
            load: function () {
                this.videoPlayer.load();
            },

            toggleAudio: function () {
                var tobeMuted = !this.videoPlayer.isMuted();
                this.setMuteStatus(
                    tobeMuted,
                    tobeMuted
                        ? MetricsManager.SOUND_TOGGLE_OFF_CAUSE.ICON_TAP
                        : MetricsManager.SOUND_TOGGLE_ON_CAUSE.ICON_TAP
                );
            },

            updateMuteClickRegionAriaPressed: function () {
                var pressed = this.$muteClickRegion.attr('aria-pressed') === 'true';
                this.$muteClickRegion.attr('aria-pressed', !pressed);
            },

            setMuteButtonStatus: function (muted) {
                var $muteIcon = this.$muteIcon;
                var $unmuteIcon = this.$unmuteIcon;
                if (muted) {
                    $muteIcon.css('fill-opacity', 1);
                    $unmuteIcon.css('fill-opacity', 0);
                } else {
                    $muteIcon.css('fill-opacity', 0);
                    $unmuteIcon.css('fill-opacity', 1);
                }
            },

            setMuteStatus: function (muted, toggleMethod) {
                var video = this;
                var videoPlayer = this.videoPlayer;
                var metricsManager = this.metricsManager;

                video.setMuteButtonStatus(muted);
                if (muted) {
                    videoPlayer.mute();
                    metricsManager && metricsManager.reportVideoSoundOff(videoPlayer.getCurrentTimeMs(), toggleMethod);
                } else {
                    videoPlayer.unmute();
                    metricsManager && metricsManager.reportVideoSoundOn(videoPlayer.getCurrentTimeMs(), toggleMethod);
                }
            },

            /**
             * Toggles the closed caption display state
             */
            toggleClosedCaption: function toggleClosedCaption() {
                if (!this.$ccClickRegion || this.$ccClickRegion.length === 0) {
                    return;
                }
                // flip the CC state
                this.ccOn = !this.ccOn;
                var toggleMethod = this.ccOn
                    ? MetricsManager.CC_TOGGLE_ON_CAUSE.ICON_TAP
                    : MetricsManager.CC_TOGGLE_OFF_CAUSE.ICON_TAP;
                this.setCcStatus(this.ccOn, toggleMethod);
            },

            /**
             * Updates the aria-pressed attribute of the closed caption click region
             * Toggles between true/false based on current state
             */
            updateCcClickRegionAriaPressed: function updateCcClickRegionAriaPressed() {
                var pressed = this.$ccClickRegion.attr('aria-pressed') === 'true';
                this.$ccClickRegion.attr('aria-pressed', !pressed);
            },

            /**
             * Updates the visual state of the CC button icons
             * @param {boolean} showCC - Whether to show the CC on or off state
             */
            setCcButtonStatus: function setCcButtonStatus(showCC) {
                var $ccOnIcon = this.$ccOnIcon;
                var $ccOffIcon = this.$ccOffIcon;
                if (showCC) {
                    $ccOnIcon.css('opacity', 1);
                    $ccOffIcon.css('opacity', 0);
                } else {
                    $ccOnIcon.css('opacity', 0);
                    $ccOffIcon.css('opacity', 1);
                }
            },

            /**
             * Sets the closed caption state and reports metrics
             * @param {boolean} showCC - Whether to enable or disable closed captions
             * @param {string} toggleMethod - The method used to toggle CC state for metrics
             */
            setCcStatus: function (showCC, toggleMethod) {
                if (!this.$ccContainer || this.$ccContainer.length === 0) {
                    return;
                }

                this.setCcButtonStatus(showCC);
                this.$ccContainer.css('visibility', showCC ? 'visible' : 'hidden');

                var metricsManager = this.metricsManager;
                if (showCC) {
                    metricsManager && metricsManager.reportVideoCcOn(toggleMethod);
                } else {
                    metricsManager && metricsManager.reportVideoCcOff(toggleMethod);
                }
            },

            /**
             * Checks and updates the closed caption text display
             *
             * This method:
             * - Checks if a CC text element exists
             * - Gets the first text track from the video element
             * - If there are active cues and the CC text is empty,
             *   updates the CC text element with the first active cue's text
             */
            checkAndUpdateCC: function checkAndUpdateCC() {
                if (this.$ccText && this.videoTag.textTracks) {
                    var textTrack = this.videoTag.textTracks[0];
                    if (
                        textTrack &&
                        textTrack.activeCues &&
                        textTrack.activeCues.length > 0 &&
                        this.$ccText.innerHTML === ''
                    ) {
                        this.$ccText.innerHTML = textTrack.activeCues[0].text;
                    }
                }
            },

            initPreviewImage: function () {
                var videoPosterData = this.videoTag.dataset.videopreviewsrc;
                var videoPoster = this.videoTag.getAttribute('poster');
                if (videoPoster !== videoPosterData) {
                    this.videoTag.setAttribute('poster', videoPosterData);
                }
                this.verifyPreviewImage(videoPosterData);
            },

            // Verifies a first-frame preview poster actually loads and, on failure, falls back to
            // the 3-second frame. Only first-frame posters are probed: the poster attribute has no
            // error event, so a probe Image mirrors the browser's fetch, and the fallback (and the
            // load-outcome metric) only apply to the first-frame experiment. The probe is injectable
            // for testing; it defaults to a new Image.
            verifyPreviewImage: function (previewImageSource, probe) {
                if (!previewImageSource || previewImageSource.indexOf(THUMBNAIL_360P_FRAME_0_CAPTURE_1) === -1) {
                    return;
                }
                var metricsManager = this.metricsManager;
                var videoTag = this.videoTag;
                var startTimeMs = Date.now();
                probe = probe || new Image();
                probe.onload = function () {
                    if (metricsManager) {
                        metricsManager.reportPreviewImageLoadSuccess(Date.now() - startTimeMs, 0);
                    }
                };
                probe.onerror = function () {
                    if (metricsManager) {
                        metricsManager.reportPreviewImageLoadFailure(Date.now() - startTimeMs, null);
                    }
                    if (videoTag) {
                        videoTag.setAttribute('poster', previewImageSource.replace(
                            THUMBNAIL_360P_FRAME_0_CAPTURE_1, THUMBNAIL_360P_FRAME_3_CAPTURE_2));
                    }
                };
                probe.src = previewImageSource;
            },

            /**
             * Since we use preload="none" in our VideoView's <video> element, its sbv-video-mute-click-region
             * element starts off hidden (see its cssClass attribute).
             */
            displayMuteClickRegion: function (display) {
                if (display) {
                    this.$muteClickRegion.addClass(STYLE_AUI_SHOW);
                    this.$muteClickRegion.removeClass(STYLE_AUI_HIDE);
                    this.metricsManager.reportAudioToggleIconDisplayed();
                } else {
                    this.$muteClickRegion.addClass(STYLE_AUI_HIDE);
                    this.$muteClickRegion.removeClass(STYLE_AUI_SHOW);
                }
            },

            displayPauseClickRegion: function (display) {
                if (this.$pauseClickRegion) {
                    if (display) {
                        this.$pauseClickRegion.addClass(STYLE_AUI_SHOW);
                        this.$pauseClickRegion.removeClass(STYLE_AUI_HIDE);
                        this.metricsManager.reportPauseIconDisplayed();
                    } else {
                        this.$pauseClickRegion.addClass(STYLE_AUI_HIDE);
                        this.$pauseClickRegion.removeClass(STYLE_AUI_SHOW);
                    }
                }
            },

            displayDurationTicker: function (display) {
                if (this.$durationTicker && this.$durationTicker.length) {
                    if (display) {
                        this.$durationTicker.removeClass(STYLE_AUI_HIDE);
                        this.metricsManager.reportDurationTickerDisplayed();
                    } else {
                        this.$durationTicker.addClass(STYLE_AUI_HIDE);
                    }
                }
            },

            displayCcClickRegion: function displayCcClickRegion(display) {
                if (display) {
                    this.$ccClickRegion.addClass(STYLE_AUI_SHOW);
                    this.$ccClickRegion.removeClass(STYLE_AUI_HIDE);
                    this.metricsManager.reportCcToggleIconDisplayed();
                } else {
                    this.$ccClickRegion.addClass(STYLE_AUI_HIDE);
                    this.$ccClickRegion.removeClass(STYLE_AUI_SHOW);
                }
            },

            showPlayButton: function (display) {
                var video = this;
                var attribution = this.attribution;
                if (display) {
                    video.$playButtonClickRegion.removeClass(STYLE_AUI_HIDE);
                    video.metricsManager.reportPlayButtonShown();
                } else {
                    video.$playButtonClickRegion.addClass(STYLE_AUI_HIDE);
                    ViewabilityManager.registerElement(
                        attribution,
                        video.videoTag,
                        0.5,
                        true,
                        true,
                        true,
                        video.onFiftyPercentViewability.bind(video)
                    );
                    ViewabilityManager.registerElement(
                        attribution,
                        video.videoTag,
                        0.01,
                        true,
                        true,
                        true,
                        video.onOnePercentViewability.bind(video)
                    );
                }
            },

            showDebugInfoCopiedHint: function (display) {
                if (display) {
                    this.$debugInfoCopiedHint.addClass(STYLE_AUI_SHOW);
                    this.$debugInfoCopiedHint.removeClass(STYLE_AUI_HIDE);
                    this.metricsManager.reportDebugInfoCopiedMessageShown();
                } else {
                    this.$debugInfoCopiedHint.addClass(STYLE_AUI_HIDE);
                    this.$debugInfoCopiedHint.removeClass(STYLE_AUI_SHOW);
                    this.metricsManager.reportDebugInfoCopiedMessageHidden();
                }
            },

            copyDebugInfoToClipboard: function () {
                var video = this;
                var metricsManager = this.metricsManager;
                if (navigator && navigator.clipboard && navigator.clipboard.writeText) {
                    var debugMetrics = JSON.stringify(this.metricsManager.getDebugMetricAttributes());
                    navigator.clipboard
                        .writeText(debugMetrics)
                        .then(function () {
                            metricsManager.reportDebugInfoCopiedSuccess(debugMetrics);

                            video.showDebugInfoCopiedHint(true);
                            setTimeout(function () {
                                video.showDebugInfoCopiedHint(false);
                            }, TIME_DEBUG_COPIED_MESSAGE_SHOW);
                        })
                        .catch(function (error) {
                            metricsManager.reportDebugInfoCopiedFailure(error.message);
                        });
                } else {
                    metricsManager.reportDebugInfoCopiedFailure('No Supports Clipboard API');
                }
            },

            manualPlay: function () {
                var video = this;
                var videoPlayer = this.videoPlayer;
                var metricsManager = this.metricsManager;
                this.showPlayButton(false);
                this.displayPauseClickRegion(true);
                this.pauseButtonClicked = false;
                videoPlayer.play();
                metricsManager.reportPlayButtonClicked(videoPlayer.getCurrentTimeMs());
                metricsManager.reportVideoPlaybackInitiated(videoPlayer.getCurrentTimeMs());
                if (video.$pauseClickRegion) {
                    video.$pauseClickRegion.trigger('focus');
                }
            },

            manualPause: function () {
                var video = this;
                var videoPlayer = this.videoPlayer;
                var metricsManager = this.metricsManager;
                this.showPlayButton(true);
                this.displayPauseClickRegion(false);
                this.pauseButtonClicked = true;
                videoPlayer.pause();
                metricsManager.reportVideoPauseButtonTriggered(videoPlayer.getCurrentTimeMs());
                metricsManager.reportVideoPauseInitiated(videoPlayer.getCurrentTimeMs());
                if (video.$playIcon) {
                    video.$playIcon.trigger('focus');
                }
            },

            onOnePercentViewability: function (percent, isInView) {
                var video = this;
                var videoPlayer = this.videoPlayer;
                var metricsManager = this.metricsManager;
                if (isInView) {
                    video.onScreenStartTime = video.getCurrentTimeMs();
                    metricsManager.reportVideoOnScreen(videoPlayer.getPercentDownloaded());
                } else {
                    // Mute the video before seeking to preserve CurrentTimeMs which
                    // is reported on mute
                    if (!videoPlayer.isMuted()) {
                        video.setMuteStatus(true, MetricsManager.SOUND_TOGGLE_OFF_CAUSE.VIDEO_OFF_SCREEN);
                    }
                    var currentTimeMs = video.getCurrentTimeMs();
                    var onScreenDuration = currentTimeMs - video.onScreenStartTime;
                    var wasBuffering = video.videoBufferingStartTime != 0;
                    metricsManager.reportVideoOffScreen(onScreenDuration, wasBuffering, videoPlayer.getCurrentTimeMs());
                    video.onScreenStartTime = 0;
                    // Clean up cc Text upon restart
                    // This is to handle the edge case where there is no CC at the beginning
                    // and the CC on exist out get staled until the first CC cuechange triggered.
                    // Note: this need to happend before reset b'c reseting video time to 0 can trigger CC cuechange at 0
                    // if the current CC is not started from the beginning.
                    if (video.$ccText) {
                        video.$ccText.innerHTML = '';
                    }
                    videoPlayer.seekToStart();
                    videoPlayer.resetContinuousPlaybackDurationMs();
                }
            },

            onFiftyPercentViewability: function (percent, isInView) {
                var video = this;
                var videoPlayer = this.videoPlayer;
                var metricsManager = this.metricsManager;
                var pauseButtonClicked = this.pauseButtonClicked;

                // If the video was paused manually, dont autoplay or autopause since it was already paused
                if (pauseButtonClicked) {
                    return;
                }

                if (isInView) {
                    videoPlayer.play();
                    videoPlayer.resetContinuousPlaybackDurationMs();
                    metricsManager.reportVideoPlaybackInitiated(videoPlayer.getCurrentTimeMs());
                    video.viewSessionStartTime = video.getCurrentTimeMs();
                    // Manually check CC when play starts
                    // Note: this is b'c we clear up CC during over of view to keep away from staled CC.
                    // And the cuechange won't trigger again if the video is out of view during the first active CC.
                    video.checkAndUpdateCC();
                } else {
                    videoPlayer.pause();
                    metricsManager.reportVideoPauseInitiated(videoPlayer.getCurrentTimeMs());
                    metricsManager.reportVideoView(
                        videoPlayer.getContinuousPlaybackDurationMs(),
                        PlatformCompatibility.isIOSWebView()
                    );
                    videoPlayer.resetContinuousPlaybackDurationMs();
                    video.viewSessionBufferingDuration = 0;
                }
            },

            onVideoReadyForPlayback: function (
                loadTimeMs,
                retryCount,
                percentDownloaded,
                videoTotalDurationMs,
                startTimeMs,
                endTimeMs
            ) {
                var metricsManager = this.metricsManager;
                metricsManager.reportVideoReadyForPlayback(
                    loadTimeMs,
                    retryCount,
                    percentDownloaded,
                    videoTotalDurationMs,
                    startTimeMs,
                    endTimeMs
                );

                // Initialize video duration ticker when video is first starting to play
                this.onDurationLeftUpdated(0, videoTotalDurationMs);
            },

            onVideoPlaybackFailure: function (videoCurrentTimeMs, errorCode, errorMessage) {
                if (this.$ccClickRegion) {
                    this.displayCcClickRegion(false);
                }
                this.displayMuteClickRegion(false);
                this.displayPauseClickRegion(false);
                this.displayDurationTicker(false);
                var metricsManager = this.metricsManager;
                metricsManager.reportVideoPlaybackFailure(videoCurrentTimeMs, errorMessage, errorCode);
            },

            onVideoPlaying: function (videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                if (this.$ccClickRegion) {
                    this.displayCcClickRegion(true);
                }
                this.displayMuteClickRegion(true);
                this.displayPauseClickRegion(true);
                this.displayDurationTicker(true);
                var metricsManager = this.metricsManager;
                metricsManager.reportVideoPlaybackStarted(videoCurrentTimeMs, percentDownloaded, droppedFrames);
            },

            onVideoPlaybackPaused: function (videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                if (this.$ccClickRegion) {
                    this.displayCcClickRegion(true);
                }
                this.displayMuteClickRegion(false);
                this.displayPauseClickRegion(false);
                this.displayDurationTicker(false);
                var metricsManager = this.metricsManager;
                metricsManager.reportVideoPaused(videoCurrentTimeMs, percentDownloaded, droppedFrames);
            },

            onVideoBufferingStarted: function (videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                var video = this;
                var metricsManager = this.metricsManager;
                video.videoBufferingStartTime = video.getCurrentTimeMs();
                metricsManager.reportVideoBufferingStarted(videoCurrentTimeMs, percentDownloaded, droppedFrames);
            },

            getCurrentTimeMs: function () {
                return Date.now();
            },

            onVideoBufferingEnded: function (videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                var video = this;
                var metricsManager = this.metricsManager;
                video.videoBufferingStartTime = 0;
                metricsManager.reportVideoBufferingEnded(videoCurrentTimeMs, percentDownloaded, droppedFrames);
            },

            onTimeToFirstFrame: function (loadTimeMs, percentDownloaded, droppedFrames, startTimeMs, endTimeMs) {
                var metricsManager = this.metricsManager;
                metricsManager.reportTimeToFirstFrame(
                    loadTimeMs,
                    percentDownloaded,
                    droppedFrames,
                    startTimeMs,
                    endTimeMs
                );
            },

            onPlaybackCompleted: function (videoCurrentTimeMs, droppedFrames, instrumentationPixelUrl) {
                var metricsManager = this.metricsManager;
                metricsManager.reportPlaybackCompleted(videoCurrentTimeMs, droppedFrames);

                // Clean up cc Text upon video ended and before looping begins
                // This is to handle the edge case where there is no CC at the beginning
                // and the CC on ending get staled until the first CC cuechange triggered
                if (this.$ccText) {
                    this.$ccText.innerHTML = '';
                }

                if (!viewMetricsHistoryMap['isCompleteLogged']) {
                    // complete log
                    viewMetricsHistoryMap['isCompleteLogged'] = true;
                    this.metricsManager.reportViewMetricsVideoComplete(instrumentationPixelUrl);
                }
            },

            onDurationPlayed: function (boundaryTime, percentDownloaded, droppedFrames) {
                var metricsManager = this.metricsManager;
                metricsManager.reportVideoDurationPlayed(boundaryTime, percentDownloaded, droppedFrames);
            },

            onContinuousDurationPlayed: function (boundaryTime) {
                var metricsManager = this.metricsManager;
                metricsManager.reportVideoView(boundaryTime, true);
            },

            logClick: function () {
                var videoPlayer = this.videoPlayer;
                var metricsManager = this.metricsManager;
                metricsManager && metricsManager.reportVideoClicked(videoPlayer.getCurrentTimeMs());
            },

            getVideoCurrentTimeMs: function () {
                return this.videoPlayer.getCurrentTimeMs();
            },

            onVideoAborted: function (videoCurrentTimeMs) {
                var metricsManager = this.metricsManager;
                metricsManager && metricsManager.reportVideoAborted(videoCurrentTimeMs);
            },

            onVideoSuspended: function (videoCurrentTimeMs) {
                var metricsManager = this.metricsManager;
                metricsManager && metricsManager.reportVideoSuspended(videoCurrentTimeMs);
            },

            onDurationLeftUpdated: function (videoCurrentTimeMs, videoTotalDurationMs) {
                if (this.$durationTickerSeconds && this.$durationTickerSeconds.length) {
                    // Assumes for now that videos are 45 seconds or less
                    var floorDeltaSeconds = Math.floor((videoTotalDurationMs - videoCurrentTimeMs) / 1000);
                    var displaySeconds = ('0' + floorDeltaSeconds).slice(-2);
                    if (!isNaN(displaySeconds) && isFinite(displaySeconds)) {
                        this.$durationTickerSeconds.html(displaySeconds);
                    }
                }
            },

            onVideoUnmute: function (instrumentationPixelUrl) {
                if (!viewMetricsHistoryMap['isUnmuteLogged']) {
                    viewMetricsHistoryMap['isUnmuteLogged'] = true;
                    this.metricsManager.reportViewMetricsVideoUnmute(instrumentationPixelUrl);
                }
            },

            onVideoViewMetricsEvent: function (
                videoCurrentTimeMs,
                videoTotalDurationMs,
                instrumentationPixelUrl,
                videoContinuousDurationMs
            ) {
                var videoDurationTimeMs = this.isVcpmEnabled ? videoContinuousDurationMs : videoCurrentTimeMs;
                var videoDurationTotalMsRelativeToAdUnit = 0;
                if (this.isVcpmEnabled && this.adUnit) {
                    videoDurationTotalMsRelativeToAdUnit =
                        this.adUnit.calculateVideoDurationTotalMsRelativeToAdUnit(videoContinuousDurationMs);
                }

                if (!viewMetricsHistoryMap['isAdUnitViewLogged'] && videoDurationTotalMsRelativeToAdUnit >= 2000) {
                    // continuous 2 seconds log viewed
                    viewMetricsHistoryMap['isAdUnitViewLogged'] = true;
                    var adUnitPercentInView = this.adUnit.getAdUnitPercentInView();
                    this.metricsManager.reportViewMetricsAdUnitViewed(
                        instrumentationPixelUrl,
                        adUnitPercentInView,
                        videoDurationTotalMsRelativeToAdUnit,
                        this.isVcpmEnabled
                    );
                }

                if (!viewMetricsHistoryMap['isViewedLogged'] && videoDurationTimeMs >= 2000) {
                    // 2 seconds log viewed
                    viewMetricsHistoryMap['isViewedLogged'] = true;
                    var videoPercentInView = ViewabilityManager.getRatioInView(this.videoTag);
                    this.metricsManager.reportViewMetricsVideoViewed(
                        instrumentationPixelUrl,
                        videoPercentInView,
                        videoDurationTimeMs,
                        this.isVcpmEnabled
                    );
                }

                if (!viewMetricsHistoryMap['isProgressFiveSecondsLogged'] && videoCurrentTimeMs >= 5000) {
                    // 5 seconds log progress5Secs
                    viewMetricsHistoryMap['isProgressFiveSecondsLogged'] = true;
                    this.metricsManager.reportViewMetricsVideoProgressFiveSeconds(instrumentationPixelUrl);
                }

                if (
                    !viewMetricsHistoryMap['isFirstQuartileLogged'] &&
                    videoCurrentTimeMs >= videoTotalDurationMs * 0.25
                ) {
                    // first quartile log
                    viewMetricsHistoryMap['isFirstQuartileLogged'] = true;
                    this.metricsManager.reportViewMetricsVideoFirstQuartile(instrumentationPixelUrl);
                }

                if (!viewMetricsHistoryMap['isMidpointLogged'] && videoCurrentTimeMs >= videoTotalDurationMs * 0.5) {
                    // midpoint log
                    viewMetricsHistoryMap['isMidpointLogged'] = true;
                    this.metricsManager.reportViewMetricsVideoMidpoint(instrumentationPixelUrl);
                }

                if (
                    !viewMetricsHistoryMap['isThirdQuartileLogged'] &&
                    videoCurrentTimeMs >= videoTotalDurationMs * 0.75
                ) {
                    // third quartile log
                    viewMetricsHistoryMap['isThirdQuartileLogged'] = true;
                    this.metricsManager.reportViewMetricsVideoThirdQuartile(instrumentationPixelUrl);
                }
            },

            onVideoPlayPromiseRejected: function (reason) {
                var metricsManager = this.metricsManager;
                if (
                    PlatformCompatibility.isIOS() &&
                    reason !== null &&
                    reason !== '' &&
                    reason.startsWith('NotAllowedError')
                ) {
                    this.showPlayButton(true);
                }
                metricsManager && metricsManager.reportVideoPlayPromiseRejected(reason);
            },

            onVideoPlayPromiseNotSupported: function () {
                var metricsManager = this.metricsManager;
                metricsManager && metricsManager.reportVideoPlayPromiseNotSupported();
            },

            init: function (attribution, sbvVideoElem, metricsManager, instrumentationPixelUrl, isVcpmEnabled, adUnit) {
                var $sbvVideoElem = A.$(sbvVideoElem);
                this.videoTag = $sbvVideoElem.find('video:first').get(0);
                var video = this;
                video.attribution = attribution;
                video.metricsManager = metricsManager;
                video.isVcpmEnabled = isVcpmEnabled;
                video.adUnit = adUnit;

                // reset the VM history map
                viewMetricsHistoryMap = {
                    isViewedLogged: false,
                    isAdUnitViewLogged: false,
                    isProgressFiveSecondsLogged: false,
                    isFirstQuartileLogged: false,
                    isMidpointLogged: false,
                    isThirdQuartileLogged: false,
                    isCompleteLogged: false,
                    isUnmuteLogged: false,
                };
                function videoReadyCallback(
                    loadTimeMs,
                    retryCount,
                    percentDownloaded,
                    videoTotalDurationMs,
                    startTimeMs,
                    endTimeMs
                ) {
                    video.onVideoReadyForPlayback(
                        loadTimeMs,
                        retryCount,
                        percentDownloaded,
                        videoTotalDurationMs,
                        startTimeMs,
                        endTimeMs
                    );
                }

                function timeToFirstFrameCallback(
                    loadTimeMs,
                    percentDownloaded,
                    droppedFrames,
                    startTimeMs,
                    endTimeMs
                ) {
                    video.onTimeToFirstFrame(loadTimeMs, percentDownloaded, droppedFrames, startTimeMs, endTimeMs);
                }

                function playbackFailureCallback(videoCurrentTimeMs, errorCode, errorMessage) {
                    video.onVideoPlaybackFailure(videoCurrentTimeMs, errorCode, errorMessage);
                }

                function videoPlayingCallback(videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                    video.onVideoPlaying(videoCurrentTimeMs, percentDownloaded, droppedFrames);
                }

                function playbackPausedCallback(videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                    video.onVideoPlaybackPaused(videoCurrentTimeMs, percentDownloaded, droppedFrames);
                }

                function bufferingStartedCallback(videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                    video.onVideoBufferingStarted(videoCurrentTimeMs, percentDownloaded, droppedFrames);
                }

                function bufferingEndedCallback(videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                    video.onVideoBufferingEnded(videoCurrentTimeMs, percentDownloaded, droppedFrames);
                }

                function playbackCompletedCallback(videoCurrentTimeMs, droppedFrames) {
                    video.onPlaybackCompleted(videoCurrentTimeMs, droppedFrames, instrumentationPixelUrl);
                }

                function durationPlayedCallback(boundaryTime, percentDownloaded, droppedFrames) {
                    video.onDurationPlayed(boundaryTime, percentDownloaded, droppedFrames);
                }

                function continuousDurationPlayedCallback(boundaryTime) {
                    video.onContinuousDurationPlayed(boundaryTime);
                }

                function videoAbortedCallback(videoCurrentTimeMs) {
                    video.onVideoAborted(videoCurrentTimeMs);
                }

                function videoSuspendedCallback(videoCurrentTimeMs) {
                    video.onVideoSuspended(videoCurrentTimeMs);
                }

                function timeUpdatedCallback(videoCurrentTimeMs, videoTotalDurationMs, videoContinuousDurationMs) {
                    video.onDurationLeftUpdated(videoCurrentTimeMs, videoTotalDurationMs);
                    video.onVideoViewMetricsEvent(
                        videoCurrentTimeMs,
                        videoTotalDurationMs,
                        instrumentationPixelUrl,
                        videoContinuousDurationMs
                    );
                }

                function videoViewMetricUnmuteCallback() {
                    video.onVideoUnmute(instrumentationPixelUrl);
                }

                function videoPlayPromiseRejectedHandler(reason) {
                    video.onVideoPlayPromiseRejected(reason);
                }

                function videoPlayPromiseNotSupportedHandler() {
                    video.onVideoPlayPromiseNotSupported();
                }

                if (
                    this.videoTag === undefined ||
                    this.videoTag === null ||
                    this.videoTag.load === undefined ||
                    this.videoTag.load === null
                ) {
                    var errorMessage;
                    if (this.videoTag === undefined || this.videoTag === null) {
                        errorMessage = 'videoTag is undefined';
                    } else {
                        errorMessage = this.videoTag.outerHTML
                            ? this.videoTag.outerHTML
                            : 'load function is undefined and outerHTML is not supported';
                    }
                    metricsManager.reportMissingVideoFunction(errorMessage);
                    //Stops function; don't build/play/load video if videoTag or load function is undefined
                    return;
                }

                video.initPreviewImage();

                // create video player object
                var videoPlayerbuilder = VideoPlayerBuilder.builder(this.videoTag)
                    .withVideoReadyForPlaybackHandler(videoReadyCallback)
                    .withTimeToFirstFrameHandler(timeToFirstFrameCallback)
                    .withVideoPlaybackFailureHandler(playbackFailureCallback)
                    .withVideoPlayingHandler(videoPlayingCallback)
                    .withVideoPlaybackPausedHandler(playbackPausedCallback)
                    .withPlaybackCompletedHandler(playbackCompletedCallback)
                    .withVideoBufferingStartedHandler(bufferingStartedCallback)
                    .withVideoBufferingEndedHandler(bufferingEndedCallback)
                    .withVideoPlayedToBoundaryHandler(DURATION_PLAYED_MRC_MS, durationPlayedCallback)
                    .withVideoPlayedToBoundaryHandler(DURATION_PLAYED_GROUPM_MS, durationPlayedCallback)
                    .withVideoPlaybackFailedAfterPlayErrorCallback(function () {
                        metricsManager.reportPlaybackFailedToStartAfterPlay();
                    })
                    .withVideoAbortedHandler(videoAbortedCallback)
                    .withVideoSuspendedHandler(videoSuspendedCallback)
                    .withTimeUpdateHandler(timeUpdatedCallback)
                    .withVideoPlayPromiseRejectedHandler(videoPlayPromiseRejectedHandler)
                    .withVideoPlayPromiseNotSupportedHandler(videoPlayPromiseNotSupportedHandler);

                if (
                    PlatformCompatibility.isIOSWebView() &&
                    !PlatformCompatibility.canUseViewWillDisappearToReportMetrics()
                ) {
                    videoPlayerbuilder = videoPlayerbuilder.withVideoPlayedToContinuousBoundaryHandler(
                        CONTINUOUS_DURATION_PLAYED_MRC_MS,
                        continuousDurationPlayedCallback
                    );
                }

                var videoPlayer = videoPlayerbuilder.build();
                video.videoPlayer = videoPlayer;

                var $videoLink = $sbvVideoElem.find('a');
                $videoLink.click(function () {
                    video.logClick();
                });

                // Setting up CC text copy over to customized container for styling purpose
                // Note: due to the limitation of the `cue` styling using VTT file, the native closed caption would take
                // the full width of the video and overlap the control buttons.
                if (this.videoTag.textTracks) {
                    var textTrack = this.videoTag.textTracks[0];
                    var $ccText = $sbvVideoElem.find('[data-itemid="sbv-video-cc-text"]')[0];
                    if (textTrack && $ccText) {
                        video.$ccText = $ccText;
                        textTrack.mode = 'hidden';
                        textTrack.addEventListener(
                            'cuechange',
                            function onCueChange() {
                                var cues = textTrack.activeCues;
                                if (cues && cues.length > 0) {
                                    $ccText.innerHTML = cues[0].text;
                                } else {
                                    // reset html if there is not active cues
                                    $ccText.innerHTML = '';
                                }
                            }.bind(this)
                        );
                    }
                }

                var $ccClickRegion = $sbvVideoElem.find('[data-itemid="sbv-video-cc-click-region"]');
                if ($ccClickRegion && $ccClickRegion.length) {
                    video.$ccClickRegion = $ccClickRegion;
                    video.$ccOffIcon = $sbvVideoElem.find('[data-itemid="sbv-video-cc-toggle-off"]');
                    video.$ccOnIcon = $sbvVideoElem.find('[data-itemid="sbv-video-cc-toggle-on"]');
                    video.$ccContainer = $sbvVideoElem.find('[data-itemid="sbv-video-cc-container"]');
                    // Initialize closed caption to be off
                    video.ccOn = false;
                    this.setCcStatus(video.ccOn, MetricsManager.CC_TOGGLE_OFF_CAUSE.VIDEO_INITIAL_OFF);

                    $ccClickRegion.click(function (e) {
                        e.preventDefault();
                        video.updateCcClickRegionAriaPressed();
                        video.toggleClosedCaption();
                    });
                }

                // The mute click region is not rendered when the video has no audio (see VideoView.jsp)
                // but these operations are still safe, as they are performed on jQuery objects.
                // The audio toggle icon should not be visible by default, even when the mute click
                // region is rendered, as the video may not have a source.  If the video does have a
                // source, make the audio toggle icon visible.
                var $muteClickRegion = $sbvVideoElem.find('[data-itemid="sbv-video-mute-click-region"]');
                video.$muteClickRegion = $muteClickRegion;
                video.$muteIcon = $sbvVideoElem.find('[data-itemid="sbv-video-mute-icon"]');
                video.$unmuteIcon = $sbvVideoElem.find('[data-itemid="sbv-video-unmute-icon"]');
                // sync mute button status according to videoPlayer isMuted
                video.setMuteButtonStatus(videoPlayer.isMuted());

                $muteClickRegion.click(function (e) {
                    e.preventDefault();
                    video.updateMuteClickRegionAriaPressed();
                    video.toggleAudio();
                    if (video.$debugInfoCopiedHint && video.$debugInfoCopiedHint.length) {
                        times_of_click_mute_button = times_of_click_mute_button + 1;
                        if (times_of_click_mute_button === TAPPING_TIMES_NEED_TO_SHOW_DEBUG_INFO) {
                            video.copyDebugInfoToClipboard();
                            times_of_click_mute_button = 0;
                        }
                    }

                    if (!videoPlayer.isMuted()) {
                        videoViewMetricUnmuteCallback();
                    }
                });

                var $durationTickerSeconds = $sbvVideoElem.find('.sbv-duration-ticker-seconds');
                video.$durationTickerSeconds = $durationTickerSeconds;

                var $durationTicker = $sbvVideoElem.find('.sbv-duration-ticker-container');
                video.$durationTicker = $durationTicker;

                var $playButtonClickRegion = $sbvVideoElem.find('[data-itemid="sbv-video-play-click-region"]');
                var $playIcon = $playButtonClickRegion.find('.sbv-video-play-button-container');
                video.$playButtonClickRegion = $playButtonClickRegion;
                video.$playIcon = $playIcon;
                $playButtonClickRegion.click(function (e) {
                    e.preventDefault();
                    video.manualPlay();
                });

                var $pauseClickRegion = $sbvVideoElem.find('[data-itemid="sbv-video-pause-click-region"]');
                video.$pauseClickRegion = $pauseClickRegion;
                video.pauseButtonClicked = false;
                $pauseClickRegion.click(function (e) {
                    e.preventDefault();
                    video.manualPause();
                });

                var $debugInfoCopiedHint = $sbvVideoElem.find('.sbv-video-debug-info-copied-message-container');
                video.$debugInfoCopiedHint = $debugInfoCopiedHint;

                // register callback for 1% and 50% viewability
                function onePercentCallback(percent, isInView) {
                    video.onOnePercentViewability(percent, isInView);
                }

                function fiftyPercentCallback(percent, isInView) {
                    video.onFiftyPercentViewability(percent, isInView);
                }

                function initiateVideoPlayabilityHelper() {
                    // not all browsers support preload (iOS Safari/WebView), so if we move to preloading in the HTML tag, we'll
                    // have to handle those browsers in JS
                    video.load();

                    ViewabilityManager.registerElement(
                        attribution,
                        video.videoTag,
                        0.5,
                        true,
                        true,
                        true,
                        fiftyPercentCallback
                    );
                    ViewabilityManager.registerElement(
                        attribution,
                        video.videoTag,
                        0.01,
                        true,
                        true,
                        true,
                        onePercentCallback
                    );
                }

                var SBVAdBlockDetectorPromise = SBVAdBlockDetector.init();

                //Should only be defined for users on desktop
                if (SBVAdBlockDetectorPromise) {
                    SBVAdBlockDetectorPromise.then(function () {
                        if (navigator.onLine) {
                            video.load();
                            video.showPlayButton(true);
                            metricsManager.reportAdBlockDetected();
                        }
                    }).catch(function () {
                        initiateVideoPlayabilityHelper();
                    });
                } else {
                    initiateVideoPlayabilityHelper();
                }
            },
        };
    }
);


/////////////////////////
// END FILE js/modules/video/VideoMixin.js
