'use strict';

P.when('A', 'rush-framework', 'sbv-single-product', 'sbv-multi-brand-video-mixin')
    .register('sbv-multi-brand-video', function MultiBrandVideo(A, RushFramework, SingleProduct, SBVMultiBrandVideoMixin) {
        var MultiBrandVideo = function() {
            this.name = 'sbv-multi-brand-video';
            this.attribution = 'sbv-multi-brand-video';
        };

        A.mixin(MultiBrandVideo.prototype, SBVMultiBrandVideoMixin);

        var multiBrandVideoComponent = new MultiBrandVideo();

        function MultiBrandVideoComponentSetup(component) {
            var $multiBrandVideo = A.$(component.elem());
            multiBrandVideoComponent.setup(multiBrandVideoComponent.attribution, $multiBrandVideo, null, null, component, SingleProduct, null);
        }

        RushFramework.registerComponent(multiBrandVideoComponent.name, multiBrandVideoComponent.attribution, MultiBrandVideoComponentSetup);
    });


