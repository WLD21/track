/*


Full source (including license, if applicable) included below.
*/
P.when('A').register('sbv-platform-compatibility', function (A) {
    var _appVersion = null;
    var _navigator = navigator;

    function isIOS() {
        return A.capabilities.ios;
    }

    function isIOSWebView() {
        return A.capabilities.isAmazonApp && A.capabilities.ios;
    }

    function isWebView() {
        return A.capabilities.isAmazonApp;
    }

    function isSafari() {
        return !!(_navigator.vendor && _navigator.vendor.match(/apple/i));
    }

    function canUseViewWillDisappearToReportMetrics() {
        if (!isIOSWebView() || !_appVersion) {
            return false;
        }

        var appVersionParts = _appVersion.split(".");
        if (appVersionParts.length < 2) {
            return false;
        }

        var majorVersion = parseInt(appVersionParts[0]);
        var minorVersion = parseInt(appVersionParts[1]);

        return majorVersion > 13 || (majorVersion === 13 && minorVersion >= 18);
    }

    function setAppVersion(appVersion) {
        _appVersion = appVersion;
    }

    function _setNavigator(nav) {
        _navigator = nav;
    }

    var compatibility = {
        isIOS: isIOS,
        isIOSWebView: isIOSWebView,
        canUseViewWillDisappearToReportMetrics: canUseViewWillDisappearToReportMetrics,
        setAppVersion: setAppVersion,
        isSafari: isSafari,
        isWebView: isWebView,
        _setNavigator: _setNavigator
    };

    return compatibility;
});


