            function buildDefaultEventAttributes() {
                var attributes = [];
                attributes[EVENT_ATTRIBUTES.AD_ID] = _adId;
                attributes[EVENT_ATTRIBUTES.METRICS_IDENTIFIER] = _metricsIdentifier;
                attributes[EVENT_ATTRIBUTES.ADVERTISER_ID] = _advertiserId;
                attributes[EVENT_ATTRIBUTES.CAMPAIGN_ID] = _campaignId;
                attributes[EVENT_ATTRIBUTES.CONTENT_HASH] = _contentHash;
                attributes[EVENT_ATTRIBUTES.WIDGET_INDEX] = _widgetIndex;
                attributes[EVENT_ATTRIBUTES.DEVICE_ENV] = _deviceEnv;
                attributes[EVENT_ATTRIBUTES.DEVICE_OS] = _deviceOs;
                attributes[EVENT_ATTRIBUTES.DEVICE_TYPE] = _deviceType;
                attributes[EVENT_ATTRIBUTES.DEVICE_PLATFORM_VERSION] = _devicePlatformVersion;
                attributes[EVENT_ATTRIBUTES.DEVICE_MODEL] = _deviceModel;
                attributes[EVENT_ATTRIBUTES.DEVICE_MAKE] = _deviceMake;
                attributes[EVENT_ATTRIBUTES.EXPERIENCE] = _experience;
                attributes[EVENT_ATTRIBUTES.EXPERIENCE_VARIATION] = _experienceVariation;
                attributes[EVENT_ATTRIBUTES.APP_VERSION] = _appVersion;
                attributes[EVENT_ATTRIBUTES.STAGE] = _stage;
                attributes[EVENT_ATTRIBUTES.SLOT_ID] = _slotId;
                attributes[EVENT_ATTRIBUTES.SEARCH_QUERY] = _searchQuery;
                attributes[EVENT_ATTRIBUTES.CLIENT_ID] = _clientId;
                attributes[EVENT_ATTRIBUTES.WEBLABS] = _weblabs;
                attributes[EVENT_ATTRIBUTES.LANGUAGE] = _language;
                attributes[EVENT_ATTRIBUTES.VIDEO_PREVIEW_IMAGE_SRC] = _videoPreviewImageSrc;
                attributes[EVENT_ATTRIBUTES.VIDEO_SRC] = _videoSrc;
                attributes[EVENT_ATTRIBUTES.VIDEO_TYPE] = _videoType;
                attributes[EVENT_ATTRIBUTES.HAS_AUDIO] = _hasAudio;
                attributes[EVENT_ATTRIBUTES.STORE_NAME] = _storeName;
                attributes[EVENT_ATTRIBUTES.STORE_URL] = _storeUrl;
                attributes[EVENT_ATTRIBUTES.STORE_CTA] = _storeCta;
                attributes[EVENT_ATTRIBUTES.MARKETPLACE_ID] = _marketplaceId;
                attributes[EVENT_ATTRIBUTES.WIDGET_TYPE] = _widgetType;
                attributes[EVENT_ATTRIBUTES.WIDGET_GROUP_ID] = _widgetGroupId;
