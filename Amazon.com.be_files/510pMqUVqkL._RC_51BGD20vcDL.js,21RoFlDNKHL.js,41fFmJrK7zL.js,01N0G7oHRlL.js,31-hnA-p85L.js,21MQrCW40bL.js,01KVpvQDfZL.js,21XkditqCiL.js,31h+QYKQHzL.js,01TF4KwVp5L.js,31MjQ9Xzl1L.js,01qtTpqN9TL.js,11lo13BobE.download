/*


Full source (including license, if applicable) included below.
*/
P.register('sbv-event-manager', function() {
    var eventListeners = {};

    function removeEventListener(element, eventName, priority, callback) {
        if (!eventListeners[element] || !eventListeners[element][eventName]) {
            return;
        }

        eventListeners[element][eventName].listeners = eventListeners[element][eventName].listeners.filter(function (listener) {
            return listener.priority !== priority || listener.callback !== callback;
        });

        if (eventListeners[element][eventName].listeners.length === 0) {
            element.removeEventListener(eventName, eventListeners[element][eventName].generatedCallback);
            delete eventListeners[element][eventName];

            if (count(eventListeners[element])) {
                delete eventListeners[element];
            }
        }
    }

    function count(dictionary) {
        var count = 0;
        for (var key in dictionary) {
            count++;
        }
        return count;
    }

    function addEventListener(attribution, element, eventName, priority, callback) {
        if (!eventListeners[element]) {
            eventListeners[element] = {};
        }

        if (!eventListeners[element][eventName]) {
            eventListeners[element][eventName] = {
                listeners: [],
                generatedCallback: generateCallback(attribution, element, eventName)
            };

            element.addEventListener(eventName, eventListeners[element][eventName].generatedCallback);
        }

        eventListeners[element][eventName].listeners.push({priority: priority, callback: callback});
        eventListeners[element][eventName].listeners.sort(function (a, b) {
            return a.priority - b.priority;
        });
    }

    function generateCallback(attribution, element, eventName) {
        return function(event) {
            if (!eventListeners[element] || !eventListeners[element][eventName]) {
                return;
            }
            eventListeners[element][eventName].listeners.forEach(function (listener) {
                if (listener.callback) {
                    try {
                        listener.callback(event);
                    } catch (err) {
                        P.log(err && err.message || 'Unknown error in callback.', 'ERROR', attribution);
                        // http://w?ClientSideMetrics/UserDocs/Instrumentation/ClientSideCounters
                        if (ue && ue.count) {
                            ue.count('sbv-js-errors', (ue.count('sbv-js-errors') || 0) + 1);
                        }
                    }
                }
            });
        }
    }

    return {
        addEventListener:addEventListener,
        removeEventListener:removeEventListener
    };
});


