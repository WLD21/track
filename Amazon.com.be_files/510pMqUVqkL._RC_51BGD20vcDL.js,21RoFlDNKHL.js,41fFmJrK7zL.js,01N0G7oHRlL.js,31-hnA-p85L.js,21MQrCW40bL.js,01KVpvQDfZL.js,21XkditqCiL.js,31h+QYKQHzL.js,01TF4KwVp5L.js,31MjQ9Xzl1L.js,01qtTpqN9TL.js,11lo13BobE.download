/*


Full source (including license, if applicable) included below.
*/
'use strict';

P.when('A', 'amzn-safe-frame-viewability', 'sbv-platform-compatibility', 'sbv-event-manager')
    .register('sbv-viewability-manager', function ViewabilityManager (A, Viewability, PlatformCompatibility, EventManager) {
        var THROTTLE_DURATION = 50;
        var EVENT_PRIORITY = 1;
        var registeredElements = [];
        var throttledOnBrowserViewChange;
        var previousViewWillDisappear;
        var attachedToViewWillDisappear = false;

        function getRatioInView (element) {
            var geom = Viewability.geom(element);
            return ((geom && geom.self && geom.self.iv) || 0);
        }

        function emitViewabilityChange (registeredElement, isInView) {
            registeredElement.isInView = isInView;
            registeredElement.callback(registeredElement.ratio, isInView);
            if (!registeredElement.recurring) {
                // circular reference deregisterElement -> detachListeners -> onBrowserViewChange ->
                //  handleViewChange -> emitViewabilityChange -> deregisterElement
                // eslint-disable-next-line no-use-before-define
                deregisterElement(registeredElement.element, registeredElement.ratio,
                    registeredElement.dispatchOnElementInView, registeredElement.dispatchOnElementOutOfView,
                    registeredElement.recurring);
            }
        }

        function handleRatioInViewChange (registeredElement, ratioInView) {
            if (registeredElement.dispatchOnElementInView && ratioInView >= registeredElement.ratio &&
                !registeredElement.isInView) {
                emitViewabilityChange(registeredElement, true);
            }

            if (registeredElement.dispatchOnElementOutOfView && ratioInView < registeredElement.ratio &&
                registeredElement.isInView) {
                emitViewabilityChange(registeredElement, false);
            }
        }

        function handleBrowserHidden (registeredElement) {
            handleRatioInViewChange(registeredElement, 0);
        }

        function handleViewChange (registeredElement) {
            var ratioInView = getRatioInView(registeredElement.element);
            handleRatioInViewChange(registeredElement, ratioInView);
        }

        throttledOnBrowserViewChange = A.throttle(function onBrowserViewChange () {
            registeredElements.forEach(handleViewChange);
        }, THROTTLE_DURATION);

        function onBrowserHidden () {
            registeredElements.forEach(handleBrowserHidden);
        }

        function onBrowserShown () {
            registeredElements.forEach(handleViewChange);
        }

        function onBrowserVisibilityChange () {
            var isBrowserHidden = document.hidden;

            if (isBrowserHidden) {
                onBrowserHidden();
            } else {
                setTimeout(onBrowserShown, 50);
            }

            registeredElements.forEach(function (registedElement) {
                if(registedElement.options && registedElement.options.onBrowserVisibilityChange) {
                    registedElement.options.onBrowserVisibilityChange(!isBrowserHidden);
                }
            });
        }

