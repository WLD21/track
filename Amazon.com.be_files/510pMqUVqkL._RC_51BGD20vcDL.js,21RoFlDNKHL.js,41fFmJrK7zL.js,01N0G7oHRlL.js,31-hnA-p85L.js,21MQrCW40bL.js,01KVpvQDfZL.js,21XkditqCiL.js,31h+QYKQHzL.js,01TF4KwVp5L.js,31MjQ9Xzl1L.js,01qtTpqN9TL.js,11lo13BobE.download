P.when('A', 'sbv-ad-unit-mixin')
    .register('sbv-ad-unit', function AdUnit(A, SBVAdUnitMixin) {
        var AdUnit = function() {
            this.attribution = null;
            this.adUnitInView = false;
            this.videoDurationStartTimeMsWhenAdInViewFirst = 0;
            this.videoDurationTotalMsWhenAdInViewFirst = 0;
            this.adUnitElement = null;
        };

        A.mixin(AdUnit.prototype, SBVAdUnitMixin);

        return {
            initialize: function(attribution, sbvVideoElem) {
                var adUnit = new AdUnit();
                adUnit.init(attribution, sbvVideoElem);
                return adUnit;
            }
        }
    });


