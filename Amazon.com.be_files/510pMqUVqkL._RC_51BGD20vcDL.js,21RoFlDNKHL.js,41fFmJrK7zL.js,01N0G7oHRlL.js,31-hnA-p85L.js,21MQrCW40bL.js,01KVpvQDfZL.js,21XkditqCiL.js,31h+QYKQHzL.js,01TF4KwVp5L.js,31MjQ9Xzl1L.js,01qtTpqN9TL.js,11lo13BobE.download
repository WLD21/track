// BEGIN FILE js/components/MultiBrandVideoMixin.js
/////////////////////////
/*


Full source (including license, if applicable) included below.
*/
P.when('A', 'base-mixin', 'sbv-multi-brand-video-carousel')
    .register('sbv-multi-brand-video-mixin', function(A, BaseMixin, MultiBrandVideoCarousel) {
        return {
            setup: function(attribution, $multiBrandVideo, singleContentElem, sbvSecondaryContentElem, component, SingleProduct, SecondaryContent) {
                (function init() {
                    var $mbvCarouselContainer = $multiBrandVideo.find('.sbv-mbv-carousel-container');
                    var builder = BaseMixin.setup(attribution, $multiBrandVideo, component);
                    var metricsManager = builder.build();

                    metricsManager.reportAceVideoResponseReceived();

                    MultiBrandVideoCarousel.initialize($mbvCarouselContainer, metricsManager, attribution, component.prop('instrumentationPixelUrl'));
                })();
            }
        }
    });


