            }

            if (self._videoElement.webkitDroppedFrameCount != undefined) {
                return self._videoElement.webkitDroppedFrameCount;
            }

            return -1;
        };

        this.getContinuousPlaybackDurationMs = function () {
            return _continuousDurationAccruedPlayTimeMs + (self.getCurrentTimeMs() - _continuousDurationStartTimeMs);
        };

        this.resetContinuousPlaybackDurationMs = function () {
