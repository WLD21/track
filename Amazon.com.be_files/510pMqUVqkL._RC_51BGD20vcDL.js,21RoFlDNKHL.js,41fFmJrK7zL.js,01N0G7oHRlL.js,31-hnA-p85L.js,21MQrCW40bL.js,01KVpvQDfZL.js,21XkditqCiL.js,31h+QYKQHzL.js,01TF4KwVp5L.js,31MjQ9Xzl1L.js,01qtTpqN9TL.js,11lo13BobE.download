            };

            this.reportVideoBufferingEnded = function (videoCurrentTimeMs, percentDownloaded, droppedFrames) {
                var event = _newEvent(EVENT_TYPES.VIDEO_BUFFERING_ENDED);
                event[EVENT_ATTRIBUTES.VIDEO_CURRENT_TIME_MS] = videoCurrentTimeMs;
                event[EVENT_ATTRIBUTES.PERCENT_DOWNLOADED] = percentDownloaded;
                event[EVENT_ATTRIBUTES.DROPPED_FRAMES] = droppedFrames;
                _recordEvent(event);
            };

            this.reportVideoPlaybackFailure = function (videoCurrentTimeMs, errorMessage, errorCode) {
                var event = _newEvent(EVENT_TYPES.VIDEO_PLAYBACK_FAILURE);
                event[EVENT_ATTRIBUTES.VIDEO_CURRENT_TIME_MS] = videoCurrentTimeMs;
                event[EVENT_ATTRIBUTES.ERROR_MESSAGE] = errorMessage;
                event[EVENT_ATTRIBUTES.ERROR_CODE] = errorCode;
                _recordEvent(event);
            };

            this.reportVideoDurationPlayed = function (videoBoundaryCrossedTimeMs, percentDownloaded, droppedFrames) {
                var event = _newEvent(EVENT_TYPES.VIDEO_DURATION_PLAYED);
                event[EVENT_ATTRIBUTES.VIDEO_BOUNDRY_CROSSED_TIME_MS] = videoBoundaryCrossedTimeMs;
                event[EVENT_ATTRIBUTES.PERCENT_DOWNLOADED] = percentDownloaded;
                event[EVENT_ATTRIBUTES.DROPPED_FRAMES] = droppedFrames;
                _recordEvent(event);
            };

            this.reportPlaybackCompleted = function (videoCurrentTimeMs, droppedFrames) {
                var event = _newEvent(EVENT_TYPES.PLAYBACK_COMPLETED);
                event[EVENT_ATTRIBUTES.VIDEO_CURRENT_TIME_MS] = videoCurrentTimeMs;
                event[EVENT_ATTRIBUTES.DROPPED_FRAMES] = droppedFrames;
                _recordEvent(event);
            };

