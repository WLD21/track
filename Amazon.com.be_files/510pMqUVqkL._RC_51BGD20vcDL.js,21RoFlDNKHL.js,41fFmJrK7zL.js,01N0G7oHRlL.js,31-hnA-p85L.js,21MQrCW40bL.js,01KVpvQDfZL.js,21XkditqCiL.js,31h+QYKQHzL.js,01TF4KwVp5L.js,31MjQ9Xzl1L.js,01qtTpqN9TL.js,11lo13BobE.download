            //
            // this work around will:
            // - allow us to get metrics the first time the customer leaves the page
            //       (iOS 12.2+ only: https://bugs.webkit.org/show_bug.cgi?id=188329)
            // - allow the video to properly restart each time the customer comes back to the page
            // - report the different view events as separate events instead of one large event
            //
            // this work around will not:
            // - report metrics the second (or later) time the customer leaves the page, they will only be reported when
            //       the customer returns (and if they return)
            if (PlatformCompatibility.isSafari() && !PlatformCompatibility.isWebView()) {
                EventManager.addEventListener(attribution, window, 'pagehide', EVENT_PRIORITY, onBrowserHidden);
                EventManager.addEventListener(attribution, window, 'pageshow', EVENT_PRIORITY, onBrowserShown);
                EventManager.addEventListener(attribution, window, 'popstate', EVENT_PRIORITY, toggleBrowserVisibility);
            }

            attachToViewWillDisappear();
        }

        function detachListeners () {
            A.off('afterReady', throttledOnBrowserViewChange);
            A.off(A.constants.BROWSER_EVENTS.SCROLL, throttledOnBrowserViewChange);
            A.off(A.constants.BROWSER_EVENTS.RESIZE, throttledOnBrowserViewChange);
            A.off(A.constants.BROWSER_EVENTS.ORIENTATION_CHANGE, throttledOnBrowserViewChange);

            EventManager.removeEventListener(document, 'visibilitychange', EVENT_PRIORITY, onBrowserVisibilityChange);
            EventManager.removeEventListener(window, 'beforeunload', EVENT_PRIORITY, onBrowserHidden);

            if (!PlatformCompatibility.isWebView()) {
                EventManager.removeEventListener(window, 'focus', EVENT_PRIORITY, onBrowserShown);
                EventManager.removeEventListener(window, 'blur', EVENT_PRIORITY, onBrowserHidden);
            }

            if (PlatformCompatibility.isSafari() && !PlatformCompatibility.isWebView()) {
                EventManager.removeEventListener(window, 'pagehide', EVENT_PRIORITY, onBrowserHidden);
                EventManager.removeEventListener(window, 'pageshow', EVENT_PRIORITY, onBrowserShown);
                EventManager.removeEventListener(window, 'popstate', EVENT_PRIORITY, toggleBrowserVisibility);
            }
        }

        function registerElement (attribution, element, ratioInView, dispatchOnElementInView, dispatchOnElementOutOfView, recurring, callback, options) {
            var elementRegistration = {
                element: element,
                ratio: ratioInView,
                dispatchOnElementInView: dispatchOnElementInView,
                dispatchOnElementOutOfView: dispatchOnElementOutOfView,
                recurring: recurring,
                callback: callback,
                options: options
            };

            if (registeredElements.length === 0) {
                attachListeners(attribution);
            }

            registeredElements.push(elementRegistration);

            handleViewChange(elementRegistration);

            return elementRegistration;
        }

        function deregisterElement (element, ratioInView, dispatchOnElementInView, dispatchOnElementOutOfView, recurring) {
            var registrationCount = registeredElements.length;

            function isRegisteredElementDiff (registeredElement) {
                return !(registeredElement.element === element &&
                    registeredElement.ratio === ratioInView &&
                    registeredElement.dispatchOnElementInView === dispatchOnElementInView &&
                    registeredElement.dispatchOnElementOutOfView === dispatchOnElementOutOfView &&
                    registeredElement.recurring === recurring);
            }

            registeredElements = registeredElements.filter(isRegisteredElementDiff);

            if (registeredElements.length === 0) {
                detachListeners();
            }

            return registrationCount !== registeredElements.length;
        }

        // MShop iOS does not always call the browser events, so use these MASH functions instead
        // window.app.willDisappear was added in 13.18
        function attachToViewWillDisappear () {
            if (PlatformCompatibility.canUseViewWillDisappearToReportMetrics() && !attachedToViewWillDisappear) {
                attachedToViewWillDisappear = true;
                if (!window.app) {
                    window.app = {};
                }
                previousViewWillDisappear = window.app.willDisappear;

                window.app.willDisappear = function() {
                    onBrowserHidden();
                    if (previousViewWillDisappear) {
                        previousViewWillDisappear();
                    }
                };
            }
        }

        return {
            /*
             * Registers a DOM element with ViewabilityManager to track if the element is viewable on the screen or not.
             *
             * element (DOM element): the DOM element to track
             * ratioInView (Number): the ratio of the element that needs to be Viewable before calling the callback
             * dispatchOnElementInView (boolean): sets whether or not the call the callback when the element starts to be at least ratio viewable
             * dispatchOnElementOutOfView (boolean): sets whether or not the call the callback when the element stops being at least ratio viewable
             * recurring (boolean): sets whether or not to keep calling the callback each time element is shown/hidden, setting
             *      to false effectively calls deregisterElement after the first event.
             * callback (function): function to be called when the viewability event is triggered.  function is called with
             *      the ratio that triggered it and whether or not the element was becoming in view or out of view
             *
             * returns the registration details
             */
            registerElement: registerElement,
            /*
             * Removes a DOM element from being tracked that was previously registered with registerElement. Typically,
             * components that call registerElement should call deregisterElement in their tearDown function.
             *
             * deregisterElement must be called with the same arguments as the call to registerElement except for the callback.
             *
             * returns if elements were deregistered
             */
            deregisterElement: deregisterElement,
            getRatioInView: getRatioInView,

            //exposed for testing only
            _handleRatioInViewChange: handleRatioInViewChange,
            _onBrowserVisibilityChange: onBrowserVisibilityChange
        };
    });



