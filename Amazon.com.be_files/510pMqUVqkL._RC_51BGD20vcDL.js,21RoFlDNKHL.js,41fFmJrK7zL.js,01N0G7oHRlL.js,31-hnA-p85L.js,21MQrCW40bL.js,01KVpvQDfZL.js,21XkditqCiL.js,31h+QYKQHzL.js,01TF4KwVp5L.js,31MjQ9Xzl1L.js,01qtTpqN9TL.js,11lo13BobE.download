            this.emitViewMetrics = function (url, viewMetrics, videoPercentInView, videoDurationTimeMs) {
                if (url === undefined) {
                    // do not make the POST call if url is undefined
                    reportViewMetricsPostRequestFailure(viewMetrics, 'instrumentationPixelUrl is undefined');
                    return;
                }

                // Sharingan pixel URLs carry an EVENT_PLACEHOLDER token in the &pe= query param
                // that the client substitutes per event and fires as a GET. The token may appear
                // url-encoded (%7BEVENT_PLACEHOLDER%7D) or raw ({EVENT_PLACEHOLDER}); detect and
                // replace both. Legacy AAX pixels keep the POST-to-/v/ path during the migration.
                if (/(%7B|\{)EVENT_PLACEHOLDER(%7D|\})/.test(url)) {
                    var sharinganPayload = {
                        def: 'iab',
                        event: viewMetrics,
                        pt: 'view',
                    };
                    if (
                        videoDurationTimeMs !== undefined &&
                        videoDurationTimeMs !== null &&
                        videoPercentInView !== undefined &&
                        videoPercentInView !== null
                    ) {
                        sharinganPayload.p = Math.round(videoPercentInView * 100);
                        sharinganPayload.t = parseFloat((videoDurationTimeMs / 1000).toFixed(3));
                    }
                    sharinganPayload.programType = 'SBV';
                    var sharinganUrl = url.replace(
                        /(%7B|\{)EVENT_PLACEHOLDER(%7D|\})/,
                        encodeURIComponent(JSON.stringify(sharinganPayload))
                    );
                    // mode: 'no-cors' returns an opaque response (status: 0, ok: false), so
                    // server-level status codes are unreadable. Only network-layer failures
                    // (DNS, TCP, connection abort) surface via .catch.
                    fetch(sharinganUrl, {
                        method: 'GET',
                        mode: 'no-cors',
                    }).catch(function (e) {
                        // Tag the source so Sharingan pixel failures are distinguishable from
                        // legacy POST failures on the same metric during the migration.
                        reportViewMetricsPostRequestFailure(viewMetrics, 'sharingan: ' + e.message);
                    });
                    return;
                }

                var payload;
                if (
                    videoDurationTimeMs !== undefined &&
                    videoDurationTimeMs !== null &&
                    videoPercentInView !== undefined &&
                    videoPercentInView !== null
                ) {
                    payload = JSON.stringify({
                        v: {
                            p: Math.round(videoPercentInView * 100),
                            t: parseFloat((videoDurationTimeMs / 1000).toFixed(3)),
                            def: 'iab',
                            event: viewMetrics,
                        },
                    });
                } else {
                    payload = JSON.stringify({
                        v: {
                            def: 'iab',
                            event: viewMetrics,
                        },
                    });
                }
                var urlWithPixelType = url.substr(-1) === '/' ? url + 'v/' : url + '/v/';
                fetch(urlWithPixelType + encodeURI(payload), {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: payload,
                })
                    .then(function (res) {
                        // For fetch function, it would only throw error when there are 5xx errors,
                        // Checking if `ok` is true would also handle 4xx errors.
                        // when status = 0, it means we cannot read the response which is expected for no-cors request
                        if (!res.ok && res.status !== 0) {
                            throw Error(res.status + ' ' + res.statusText);
                        }
                    })
                    .catch(function (e) {
                        reportViewMetricsPostRequestFailure(viewMetrics, e.message);
                    });
            };

            this.getDebugMetricAttributes = function () {
                return {
                    searchQuery: _defaultMetricsAttributes[EVENT_ATTRIBUTES.SEARCH_QUERY],
                    adId: _defaultMetricsAttributes[EVENT_ATTRIBUTES.AD_ID],
                    advertiserId: _defaultMetricsAttributes[EVENT_ATTRIBUTES.ADVERTISER_ID],
                    campaignId: _defaultMetricsAttributes[EVENT_ATTRIBUTES.CAMPAIGN_ID],
                    contentHash: _defaultMetricsAttributes[EVENT_ATTRIBUTES.CONTENT_HASH],
                    metricsIdentifier: _defaultMetricsAttributes[EVENT_ATTRIBUTES.METRICS_IDENTIFIER],
                    clientId: _defaultMetricsAttributes[EVENT_ATTRIBUTES.CLIENT_ID],
                    region: _getRegion(),
                    stage: _defaultMetricsAttributes[EVENT_ATTRIBUTES.STAGE],
                };
            };

            function _newEvent(eventType) {
                var widgetDimensions = SbvClientUtil.getWidgetDimensions(_widgetElement);
                var event = A.$.extend({}, _defaultMetricsAttributes);
                event[EVENT_ATTRIBUTES.EVENT_TYPE] = eventType;
                event[EVENT_ATTRIBUTES.METRICS_SEQUENCE_NUMBER] = _metricsSequenceNumber++;
                event[EVENT_ATTRIBUTES.NETWORK_TYPE] =
                    (navigator && navigator.connection && navigator.connection.type) || 'Unknown';
                event[EVENT_ATTRIBUTES.WIDTH] = widgetDimensions.width;
                event[EVENT_ATTRIBUTES.HEIGHT] = widgetDimensions.height;
                event[EVENT_ATTRIBUTES.VIEWPORT_WIDTH] = widgetDimensions.viewportWidth;
                event[EVENT_ATTRIBUTES.VIEWPORT_HEIGHT] = widgetDimensions.viewportHeight;
                return event;
            }

            function _recordEvent(event, highPriority) {
                _sushiClient && _sushiClient.processEvent(event, DEFAULT_HIGH_PRIORITY_SUSHI_CLIENT_OPTIONS);
                _automatedTestMetricsClient && _automatedTestMetricsClient.processEvent(event);
            }

            function _forceFlushSushiClient() {
                _sushiClient && _sushiClient.flush(_sushiClient, true);
            }

            // Parse sushiSourceGroupEndpoint url get region string.
            // https://unagi-na.amazon.com/1/events/com.amazon.eel.sbv.client.beta.events return 'na'
            // https://unagi-eu.amazon.com/1/events/com.amazon.eel.sbv.client.prod.eu return 'eu'
            // https://unagi-fe.amazon.com/1/events/com.amazon.eel.sbv.client.beta.fe return 'fe'
            function _getRegion() {
                var region;
                if (sushiSourceGroupEndpoint) {
                    region = sushiSourceGroupEndpoint.split('-')[1];
                    if (region) {
                        region = region.split('.')[0].toUpperCase();
                        return region;
                    }
                }
                return 'UNKNOWN';
            }
        }

