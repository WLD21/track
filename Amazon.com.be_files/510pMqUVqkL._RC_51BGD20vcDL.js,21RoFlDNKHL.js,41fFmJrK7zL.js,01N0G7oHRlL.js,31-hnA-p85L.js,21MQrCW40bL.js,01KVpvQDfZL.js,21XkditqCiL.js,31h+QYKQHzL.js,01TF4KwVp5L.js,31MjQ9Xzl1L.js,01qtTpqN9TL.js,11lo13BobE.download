/*


Full source (including license, if applicable) included below.
*/
P.when('A', 'sbv-viewability-manager')
    .register('sbv-ad-unit-mixin', function (A, ViewabilityManager) {
        return {
            init: function (attribution, sbvVideoElem) {
                this.attribution = attribution;
                this.adUnitElement = sbvVideoElem;
            },

            attach: function() {
                var adunit = this;
                // setup viewbility manager
                ViewabilityManager.registerElement(this.attribution,
                    this.adUnitElement,
                    0.5,
                    true,
                    true,
                    true,
                    this.onFiftyPercentViewability.bind((adunit)));
            },

            onFiftyPercentViewability: function (percent, isInView) {
                this.adUnitInView =  isInView;
            },

            isAdUnitInView: function () {
                return this.adUnitInView;
            },

            calculateVideoDurationTotalMsRelativeToAdUnit: function (videoContinuousDurationMs) {
                if (this.isAdUnitInView()) {
                    this.videoDurationTotalMsWhenAdInViewFirst =
                        videoContinuousDurationMs - this.videoDurationStartTimeMsWhenAdInViewFirst;
                } else {
                    this.videoDurationTotalMsWhenAdInViewFirst = 0;
                    this.videoDurationStartTimeMsWhenAdInViewFirst = videoContinuousDurationMs;
                }
                return this.videoDurationTotalMsWhenAdInViewFirst;
            },

            getAdUnitPercentInView: function () {
                return ViewabilityManager.getRatioInView(this.adUnitElement);
            }
        };
    });


/////////////////////////
// END FILE js/modules/adunit/AdUnitMixin.js
