/*


Full source (including license, if applicable) included below.
*/
P.when('A', 'sbv-video-single-content-mixin')
   .register('sbv-single-product', function (A, VideoSingleContentMixin) {
       var TEMPLATE_ID = "video-single-product";

       var SingleProduct = function() {
            this.init = function(sbvSingleProductElem, metricsManager, media) {
                A.$(sbvSingleProductElem).find('a:not(.sbv-store-ingress-link)').click(function ()  {
                    var videoCurrentTimeMS = media && media.getVideoCurrentTimeMs && media.getVideoCurrentTimeMs();
                    metricsManager.reportProductClicked(videoCurrentTimeMS);
                });

                var $productImage = A.$(sbvSingleProductElem).find('.sbv-product-img');
                if ($productImage.data("imgsrc")) {
                    $productImage.attr("src", $productImage.data("imgsrc"));
                }

                // Title
                var title = A.$(sbvSingleProductElem).find('.faceout-product-title');
                A.$(title).find('a').click(function () {
                    metricsManager.reportProductTitleClicked();
                });

                // Review Count
                var reviewCount = A.$(sbvSingleProductElem).find('.faceout-product-review');
                A.$(reviewCount).find('a').click(function () {
                    metricsManager.reportProductReviewCountClicked();
                });

                // Price
                var price = A.$(sbvSingleProductElem).find('.faceout-product-price');
                A.$(price).find('a').click(function () {
                    metricsManager.reportProductPriceClicked();
                });
            }
       }

       A.mixin(SingleProduct.prototype, VideoSingleContentMixin);

       return {

           initialize: function(sbvSingleProductElem, metricsManager, media) {
               var singleProduct = new SingleProduct();
               var $sponsoredLabel = A.$(sbvSingleProductElem).find('.sbv-sponsored-label');
               var feedbackElem = A.$(sbvSingleProductElem).find('.sbv-ad-feedback').get(0);
               singleProduct.init(sbvSingleProductElem, metricsManager, media);
               singleProduct.loadAdFeedback(metricsManager, TEMPLATE_ID, $sponsoredLabel, feedbackElem);
               return singleProduct;
           }
       };
   });


