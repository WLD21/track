                event[EVENT_ATTRIBUTES.VIDEO_CURRENT_TIME_MS] = videoCurrentTimeMs;
                event[EVENT_ATTRIBUTES.PERCENT_DOWNLOADED] = percentDownloaded;
                event[EVENT_ATTRIBUTES.DROPPED_FRAMES] = droppedFrames;
