/////////////////////////
// BEGIN FILE js/components/BaseMixin.js
/////////////////////////
/*


Full source (including license, if applicable) included below.
*/
P.when(
    'A',
    'sbv-metrics-manager',
    'sbv-automated-test-metrics-client',
    'sbv-platform-compatibility',
    'sbv-latency-event-handler'
).register('base-mixin', function (A, MetricsManager, AutomatedTestMetricsClient, PlatformCompatibility) {
    return {
        setup: function (attribution, $content, component) {
            var metricsManagerBuilder = undefined;
            (function init() {
                PlatformCompatibility.setAppVersion(component.prop('appVersion'));
                metricsManagerBuilder = MetricsManager.builder()
                    .withAttribution(attribution)
                    .withWidgetElement($content)
                    .withMetricsIdentifier(component.prop('metricsIdentifier'))
                    .withAdId(component.prop('adId'))
                    .withAdvertiserId(component.prop('advertiserId'))
                    .withCampaignId(component.prop('campaignId'))
                    .withSlotId(component.prop('slotId'))
                    .withSearchQuery(component.prop('searchQuery'))
                    .withWidgetIndex(component.prop('widgetIndex'))
                    .withDeviceEnv(component.prop('deviceEnv') || '')
                    .withDeviceOs(component.prop('deviceOs') || '')
                    .withDeviceType(component.prop('deviceType') || '')
                    .withDevicePlatformVersion(component.prop('devicePlatformVersion') || '')
                    .withDeviceModel(component.prop('deviceModel') || '')
                    .withDeviceMake(component.prop('deviceMake') || '')
                    .withExperience(component.prop('experience'))
                    .withExperienceVariation(component.prop('experienceVariation'))
                    .withAppVersion(component.prop('appVersion') || '')
                    .withRequestId(component.prop('requestId'))
                    .withStage(component.prop('stage'))
                    .withClientId(component.prop('clientId'))
                    .withWeblabs(component.prop('weblabs'))
                    .withLanguage(component.prop('language'))
                    .withMarketplaceId(component.prop('marketplaceId'))
                    .withWidgetType(component.prop('widgetType'))
                    .withWidgetGroupId(component.prop('widgetGroupId'))
                    .withPageType(component.prop('pageType'))
                    .withPageNumber(component.prop('pageNumber'))
                    .withPageLayout(component.prop('pageLayout') || '')
                    .withSushiSourceGroupEndpoint(component.prop('sushiSourceGroupEndpoint'));

                if (typeof AUI_JS_DEBUG !== 'undefined' && AUI_JS_DEBUG) {
                    var automatedTestMetricsClient = AutomatedTestMetricsClient.newClient($content);
                    metricsManagerBuilder =
                        metricsManagerBuilder.withAutomatedTestMetricsClient(automatedTestMetricsClient);
                }
            })();
            return metricsManagerBuilder;
        },
    };
});


